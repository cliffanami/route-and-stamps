# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local Supabase CLI only (supabase/config.toml env() substitution) — Google OAuth
# client credentials from Google Cloud Console, set for the *hosted* project via
# the Supabase dashboard's Auth → Providers → Google screen, not this file.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# M1.5 Tier 2 place-name extraction (ARCHITECTURE.md §1c) — both left unset
# by default. With ENABLE_AI_PLACE_EXTRACTION unset or not "true", or with
# ANTHROPIC_API_KEY unset, /api/extract-place is a no-op and the add-a-place
# flow falls back to Tier 1 / the manual Inbox path. Set a hard per-key spend
# limit in the Anthropic Console before ever setting these for real.
ENABLE_AI_PLACE_EXTRACTION=
ANTHROPIC_API_KEY=

# M2 Instagram embeds (ROADMAP.md M2) — Meta app access token, required by
# Instagram's oEmbed endpoint (unlike TikTok's, which is keyless). Left unset
# until the Meta Developer app is registered; until then Instagram links fall
# back to the same "no embed available" state as a private/deleted post.
# TikTok embeds work with no token needed.
INSTAGRAM_OEMBED_ACCESS_TOKEN=

# Push notifications (ROADMAP.md "Push notifications") — public VAPID key
# only; safe to ship to the client, it's what applicationServerKey signs
# against. Generate a pair with `npx web-push generate-vapid-keys`. The
# private key, VAPID subject, and the send-push Edge Function's internal
# auth secret are NOT here — they live as Supabase Edge Function secrets
# (`supabase secrets set`), never in this app's own env, since only the
# Edge Function (not Next.js) ever sends a push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
