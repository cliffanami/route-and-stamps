# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local Supabase CLI only (supabase/config.toml env() substitution) — Google OAuth
# client credentials from Google Cloud Console, set for the *hosted* project via
# the Supabase dashboard's Auth → Providers → Google screen, not this file.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
